DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Role required to use Rust commands and the web pairing/account area.
DISCORD_ACCESS_ROLE_ID=
# Comma-separated Discord user IDs allowed to manage all Rust+ accounts.
ADMIN_DISCORD_IDS=

# Local: ./data   Railway volume: /data
DATA_DIR=./data
RUST_COMMAND_PREFIX=!
TEAM_CHAT_POLL_MS=2500
TEAM_INFO_POLL_MS=10000

# Web panel. Local example: http://localhost:3000
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=
# Generate with: npm run gen-key
ENCRYPTION_KEY=

# Automatic Rust team-chat event alerts.
EVENT_ALERTS_ENABLED=true
EVENT_POLL_MS=15000
# Optional Discord text channel for the same alerts.
DISCORD_ALERT_CHANNEL_ID=
